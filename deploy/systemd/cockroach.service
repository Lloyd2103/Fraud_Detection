[Unit]
Description=CockroachDB Distributed Node
After=network.target

[Service]
Type=notify
User=fraud
Group=fraud
# Lưu ý: Thay 192.168.80.201 bằng IP của từng node tương ứng (201, 202, 203)
ExecStart=/usr/local/bin/cockroach start --insecure --store=/home/fraud/cockroach-data --listen-addr=0.0.0.0:26257 --advertise-addr=192.168.80.201:26257 --http-addr=0.0.0.0:8082 --join=192.168.80.201:26257,192.168.80.202:26257,192.168.80.203:26257
TimeoutStopSec=60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
